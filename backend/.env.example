# Environment Mode (development | production)
NODE_ENV=production

# Backend Server Port (Default: 8000)
PORT=8000

# Production Frontend URL (Allowed by CORS for credentials and cookies)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# MongoDB Atlas URI (Recommended for production data persistence)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jobportal?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a random 64-char string)
SECRET_KEY=generate_a_super_strong_random_secret_for_production

# Cloudinary Credentials (Required for uploading candidate resumes and company logos)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
